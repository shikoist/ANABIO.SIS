	DEL SOUND.ERR
	DEL KEYBOARD.OBJ
	DEL KEYBOARD.ERR
	DEL CAMERA.OBJ
	DEL CAMERA.ERR
 	DEL OBJECT.OBJ
	DEL OBJECT.ERR

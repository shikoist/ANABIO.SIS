	DEL MESH.ERR
 	DEL TIMER.OBJ
	DEL TIMER.ERR
 	DEL FILE.OBJ
	DEL FILE.ERR
 	DEL TEXTURE.OBJ
	DEL TEXTURE.ERR
 	DEL TEXT.OBJ
	DEL TEXT.ERR
 	DEL PRIMITIV.OBJ
	DEL PRIMITIV.ERR
 	DEL MATRIX.OBJ
	DEL MATRIX.ERR
 	DEL FASTMATH.OBJ
	DEL FASTMATH.ERR
 	DEL MAIN.OBJ
	DEL MAIN.ERR
	DEL MAIN.MAP
	DEL MAIN.EXE
